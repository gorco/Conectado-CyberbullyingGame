{
	"bed":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "我得走了。"
			}]
		}		
	},
	"init":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "node0",
				"condition": "varObject('global', 'NotRepeatedDaysNonStatic') == false"
			}]
		},
		"node0": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "今天手机显示的日期是正确的。"
			},
			{
				"tag": "你",
				"msn": "昨天是怎么回事？"
			},
			{
				"tag": "你",
				"msn": "那是梦吗？还是前一天的事？"
			},
			{
				"tag": "你",
				"msn": "我是不是要疯了？"
			}]
		}
	},
	"wardrobeInside1":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "我现在不需要这里任何东西。"
			}]
		}		
	},
	"wardrobeInside2":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "现在我没心情整理。"
			}]
		}		
	},
	"bag":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "你",
				"msn": "我拿上东西就走。"
			}]
		},
		"node1": {
			"type": "event",
			"event": {
				"name": "pick",
				"var": "BagPicked",
				"value": true
			}
		},
	},
	"computer":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "你",
				"msn": "如果我现在开机，肯定会迟到的。"
			},
			{
				"tag": "你",
				"msn": "还是等到下午吧。"
			},
			{
				"tag": "电脑",
				"msn": "你想打开电脑吗？"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "turnOnPC",
			"options": [{
				"next": "node1a",
				"msn": "是"
			},
			{
				"next": "node1b",
				"msn": "否"
			}]
		},
		"node1a": {
			"type": "event",
			"next": "moveCamera",
			"event":{
				"name": "computerON"
			}
		}, 
		"moveCamera": {
			"type": "event",
			"next": "changeHour",
			"event":{
				"name": "move camera",
				"key": "computer"
			}
		},
		"changeHour": {
			"type": "event",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:10",
			}
		},
		"node1b": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "我现在最好离开。"
			}]
		}		
	},
	"plug":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "你",
				"msn": "我应该让手机继续充电吗？"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "plugInMobile",
			"options": [{
				"next": "node1a",
				"msn": "是"
			},
			{
				"next": "node1b",
				"msn": "否"
			}]
		},
		"node1a": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": true,
				"state": 0
			}
		}, 
		"node1b": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": false,
				"state": 1
			}
		}		
	},
	"livingroomDoor" : {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "livingroom"
			}
		}
	}
}