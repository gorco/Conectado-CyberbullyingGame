		},
		"nodeRepeat": {
			"type": "dialog",
			"fragments": [{
				"tag": "何塞",
				"character": "Jose",
				"msn": "再见"
			}]
		},
		"node0": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "何塞",
				"character": "Jose",
				"msn": "你看到过那个可以看你和聊天最多的人的关系的手机应用吗？"
			},
			{
				"tag": "何塞",
				"character": "Jose",
				"msn": "它会告诉你，在所有下载了这个应用的人中，你和谁相处得来，和谁相处不来。"
			},
			{
				"tag": "何塞",
				"character": "Jose",
				"msn": "据说它非常准确，但不清楚它是如何工作的。"
			},
			{
				"tag": "何塞",
				"character": "Jose",
				"msn": "我看到你已经有了。"
			}]
		},
		"setter":{
			"type": "setter",
			"next": "quest",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
		"quest": {
			"type": "event",
			"event": {
				"name": "change variable",
				"var": "JoseQuest",
				"value": 1,
			}
		},
	},
