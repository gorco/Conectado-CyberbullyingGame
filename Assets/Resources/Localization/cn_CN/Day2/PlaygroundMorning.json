	"schoolEnter": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "enterNode",
				"condition": "varObject('state', 'BellSounded') == true" 
			},
			{
				"next": "dialogNode",
				"condition": "varObject('state', 'BellSounded') == false"
			}]
		},
		"enterNode": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "stairs"
			}
		},
		"dialogNode": {
			"type": "dialog",
			"fragments": [{
				"tag": "",
				"msn": "看起来我到的太早了，现在还不能进去。我最好消磨一下时间。"
			}]
		}
	},
	"schoolExit": {
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
