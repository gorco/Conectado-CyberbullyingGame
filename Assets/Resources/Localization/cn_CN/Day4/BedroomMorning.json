{
	"init":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "node0",
				"condition": "varObject('global', 'RepeatedNonStatic') == true"
			}]
		},
		"node0": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "又是一天重复的日子...我还在做梦吗？"
			},
			{
				"tag": "你",
				"msn": "那个声音是从那个传送门里传来的吗？"
			},
			{
				"tag": "你",
				"msn": "为什么我两次穿过那个传送门的时候日子都重复了？"
			}]
		}
	},
	"bed":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "又是新的一天。我得走了，希望快点结束。"
			}]
		}		
	},
	"wardrobeInside1":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "这里什么有用的东西都没有。"
			}]
		}		
	},
	"wardrobeInside2":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "也许我现在应该整理这些，而不是去上学...妈妈会生气的。"
			}]
		}		
	},
	"bag":{
		"root": {
			"type": "dialog",
			"next": "node2",
			"fragments": [{
				"tag": "你",
				"msn": "得走了..."
			}]
		},
		"node2": {
			"type": "event",
			"event": {
				"name": "pick",
				"var": "BagPicked",
				"value": true
			}
		},
	},
	"computer":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "你",
				"msn": "如果我现在开机，肯定会迟到的。"
			},
			{
				"tag": "你",
				"msn": "总是这样，最好还是等到下午再开机。"
			},
			{
				"tag": "电脑",
				"msn": "你想打开电脑吗？"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "turnOnPC",
			"options": [{
				"next": "node1a",
				"msn": "是的"
			},
			{
				"next": "node1b",
				"msn": "不"
			}]
		},
		"node1a": {
			"type": "event",
			"next": "moveCamera",
			"event":{
				"name": "computerON"
			}
		}, 
		"moveCamera": {
			"type": "event",
			"next": "changeHour",
			"event":{
				"name": "move camera",
				"key": "computer"
			}
		},
		"changeHour": {
			"type": "event",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:10",
			}
		},
		"node1b": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "我还是现在离开吧。"
			}]
		}		
	},
	"plug":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "你",
				"msn": "我要不要把手机留着充电？"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "plugInMobile",
			"options": [{
				"next": "node1a",
				"msn": "是的"
			},
			{
				"next": "node1b",
				"msn": "不"
			}]
		},
		"node1a": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": true,
				"state": 0
			}
		}, 
		"node1b": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": false,
				"state": 1
			}
		}		
	},
	"livingroomDoor" : {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "livingroom"
			}
		}
	}
}