{
	"board":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "看起来有人拍了昨天的照片。"
			}]
		}
	},
	"class":{
		"root": {
				"type": "fork",
				"options": [{
					"next": "minutes",
					"condition": "varObject('global', 'HourNonStatic') >= 8"
				}]
		},
		"minutes": {
				"type": "fork",
				"options": [{
					"next": "node1",
					"condition": "varObject('global', 'MinuteNonStatic') > 30"
				}]
		},
		"node1": {
			"type": "dialog",
			"next": "node2",
			"fragments": [{
				"tag": "老师",
				"character": "Teacher",
				"msn": "<$ varObject('global', 'UserNameNonStatic') $>，你迟到了。"
			},{
				"tag": "老师",
				"character": "Teacher",
				"msn": "请坐下，我们继续上课。"
			}]
		},
		"node2": {
			"type": "fork",
			"options": [{
				"next": "endDay",
				"condition": "varObject('global', 'SharedPassQuestNonStatic') == 1"
			},
			{
				"next": "break",
				"condition": "true"
			}]
		},
		"break": {
			"type": "event",
			"next": "breakHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "铃声响了，休息时间到了……"
			}
		},
		"breakHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "11:05",
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 20
			}
		},
		"endDay": {
			"type": "event",
			"next": "breakHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "好像课程越来越长了...幸好是时候回家了."
			}
		},
		"endDayHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05",
			}
		}
	},
	"table":{
		"root": {
			"type": "dialog",
			"next": "options",
			"fragments": [{
				"tag": "你",
				"msn": "这里有空位。我可以坐这里吗？"
			}]
		},
		"options": {
			"type": "options",
			"questionId": "sitDownClass",
			"options": [{
				"next": "node2",
				"msn": "可以"
			},
			{
				"msn": "不可以"
			}]
		},
		"node2": {
			"type": "dialog",
			"next": "nodeFork",
			"fragments": [{
				"tag": "",
				"msn": "（后面有动静，老师来了）"
			}]
		},
		"nodeFork": {
			"type": "fork",
			"options": [{
				"next": "endDay",
				"condition": "varObject('global', 'SharedPassQuestNonStatic') == 1"
			},
			{
				"next": "break",
				"condition": "true"
			}]
		},
		"break": {
			"type": "event",
			"next": "breakHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "铃声响了，休息时间到了……"
			}
		},
		"breakHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "11:05",
			}
		},
		"endDay": {
			"type": "event",
			"next": "changeHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "好像课程越来越长了...幸好是时候回家了。"
			}
		},
		"changeHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05",
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 20
			}
		}
	},
}