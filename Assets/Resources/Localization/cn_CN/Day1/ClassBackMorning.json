			},
			{
				"next": "node3b",
				"msn": "（问你可以坐在哪里）"
			}]
		},
		"node3a": {
			"type": "event",
			"next": "node4",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "大家就坐，课堂开始了。"
			}
		},
		"node4": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "classFront"
			}
		},
		"node3b": {
			"type": "dialog",
			"next": "node3a",
			"fragments": [{
				"tag": "老师",
				"character": "Teacher",
				"msn": "坐在艾莉森的旁边。"
			},
			{
				"tag": "老师",
				"character": "Teacher",
				"msn": "艾莉森，帮我一下，解答一下<$ varObject('global', 'UserNameNonStatic') $>对学校的任何疑问。"
			}]
		},
	}
