{
	"board":{
		"root": {
			"type": "event",
			"next": "forkNode",
			"event": {
				"name": "change variable",
				"var": "BoardQuest",
				"value": 1
			}
		},
		"forkNode": {
			"type": "fork",
			"options": [{
				"next": "gum",
				"condition": "varObject('global', 'GumQuestNonStatic') == 0"
			},
			{
				"next": "washed",
				"condition": "varObject('global', 'GumQuestNonStatic') == 1"
			},
			{
				"next": "nogum",
				"condition": "varObject('global', 'GumQuestNonStatic') == 2"
			}]
		},
		"gum": {
			"type": "event",
			"next": "gumDialog",
			"event": {
				"name": "active object",
				"time": 0,
				"other": "photoGum"
			}
		},
		"gumDialog": {
			"type": "dialog",
			"next": "deactive",
			"fragments": [{
				"tag": "Você",
				"msn": "Tem uma foto minha e editaram para parecer que estou com chicletes colados no meu traseiro."
			},
			{
				"tag": "Você",
				"msn": "Quem iria querer me humilhar desse jeito?"
			}]
		},
		"deactive": {
			"type": "event",
			"event": {
				"name": "deactive object",
				"time": 0
			}
		},
		"washed": {
			"type": "event",
			"next": "washedDialog",
			"event": {
				"name": "active object",
				"time": 0,
				"other": "photoGumWhased"
			}
		},
		"washedDialog": {
			"type": "dialog",
			"next": "deactive",
			"fragments": [{
				"tag": "Você",
				"msn": "É uma foto minha de ontem, logo depois que eu tirei o chiclete."
			},
			{
				"tag": "Você",
				"msn": "Escreveram uma frase super original... \"Um bebê chegou à aula\"."
			}]
		},
		"nogum": {
			"type": "event",
			"next": "nogumDialog",
			"event": {
				"name": "active object",
				"time": 0,
				"other": "photoDog"
			}
		},
		"nogumDialog": {
			"type": "dialog",
			"next": "deactive",
			"fragments": [{
				"tag": "Você",
				"msn": "É uma foto de um cachorro com meu rosto e a língua de fora."
			},
			{
				"tag": "Você",
				"msn": "Por que fizeram isso? Quem colocou isso aqui?"
			}]
		}
	},
	"class":{
		"root": {
				"type": "fork",
				"options": [{
					"next": "minutes",
					"condition": "varObject('global', 'HourNonStatic') >= 8"
				}]
		},
		"minutes": {
				"type": "fork",
				"options": [{
					"next": "node1",
					"condition": "varObject('global', 'MinuteNonStatic') > 30"
				}]
		},
		"node1": {
			"type": "dialog",
			"next": "node2",
			"fragments": [{
				"tag": "Professor",
				"character": "Teacher",
				"msn": "<$ varObject('global', 'UserNameNonStatic') $>, você está <$ if(varObject('global', 'MaleSexNonStatic')==true, 'atrasado', 'atrasada') $>."
			},{
				"tag": "Professor",
				"character": "Teacher",
				"msn": "Por favor, sente-se para continuarmos a aula."
			}]
		},
		"node2": {
			"type": "event",
			"next": "node3",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "O dia foi chato. As aulas terminaram e a maioria das pessoas te ignorou o tempo todo. Tem um bilhete na sua mesa dizendo para você ir ao banheiro, alguém está te esperando por lá."
			}
		},
		"node3": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05",
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 15
			}
		}
	},
	"table":{
		"root": {
			"type": "dialog",
			"next": "options",
			"fragments": [{
				"tag": "Você",
				"msn": "Este lugar está livre, posso me sentar?"
			}]
		},
		"options": {
			"type": "options",
			"questionId": "sitDownClass",
			"options": [{
				"next": "node2",
				"msn": "Sim"
			},
			{
				"msn": "Não"
			}]
		},
		"node2": {
			"type": "dialog",
			"next": "node3",
			"fragments": [{
				"tag": "",
				"msn": "(Você ouve passos se aproximando, o professor chegou.)"
			}]
		},
		"node3": {
			"type": "event",
			"next": "changeHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "O dia foi chato. As aulas terminaram e a maioria das pessoas te ignorou o tempo todo. Tem um bilhete na sua mesa dizendo para você ir ao banheiro, alguém está te esperando por lá."
			}
		},
		"changeHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05"
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 15
			}
		}
	}
}