{
	"board":{
		"root": {
			"type": "event",
			"next": "forkNode",
			"event": {
				"name": "change variable",
				"var": "BoardQuest",
				"value": 1,
			}
		},
		"forkNode": {
			"type": "fork",
			"options": [{
				"next": "gum",
				"condition": "varObject('global', 'GumQuestNonStatic') == 0"
			},
			{
				"next": "washed",
				"condition": "varObject('global', 'GumQuestNonStatic') == 1"
			},
			{
				"next": "nogum",
				"condition": "varObject('global', 'GumQuestNonStatic') == 2"
			}]
		},
		"gum": {
			"type": "event",
			"next": "gumDialog",
			"event": {
				"name": "active object",
				"time": 0,
				"other": "photoGum"
			}
		},
		"gumDialog": {
			"type": "dialog",
			"next": "deactive",
			"fragments": [{
				"tag": "You",
				"msn": "Tem uma foto minha ali e foi editada para parecer que estou cheio de chicletes no meu traseiro."
			},
			{
				"tag": "You",
				"msn": "Quem iria querer me ridicularizar assim?"
			}]
		},
		"deactive": {
			"type": "event",
			"event": {
				"name": "deactive object",
				"time": 0
			}
		},
		"washed": {
			"type": "event",
			"next": "washedDialog",
			"event": {
				"name": "active object",
				"time": 0,
				"other": "photoGumWhased"
			}
		},
		"washedDialog": {
			"type": "dialog",
			"next": "deactive",
			"fragments": [{
				"tag": "You",
				"msn": "É uma foto minha de ontem logo após eu ter limpado o chiclete."
			},
			{
				"tag": "You",
				"msn": "Escreveram uma frase muito original... \"Um bebê chegou à aula\"."
			}]
		},
		"nogum": {
			"type": "event",
			"next": "nogumDialog",
			"event": {
				"name": "active object",
				"time": 0,
				"other": "photoDog"
			}
		},
		"nogumDialog": {
			"type": "dialog",
			"next": "deactive",
			"fragments": [{
				"tag": "You",
				"msn": "É uma foto de um cachorro com meu rosto e com a língua para fora."
			},
			{
				"tag": "You",
				"msn": "Por quê? Quem foi que colocou isso aqui?"
			}]
		},
	},
	"class":{
		"root": {
				"type": "fork",
				"options": [{
					"next": "minutes",
					"condition": "varObject('global', 'HourNonStatic') >= 8"
				}]
		},
		"minutes": {
				"type": "fork",
				"options": [{
					"next": "node1",
					"condition": "varObject('global', 'MinuteNonStatic') > 30"
				}]
		},
		"node1": {
			"type": "dialog",
			"next": "node2",
			"fragments": [{
				"tag": "Teacher",
				"character": "Teacher",
				"msn": "<$ varObject('global', 'UserNameNonStatic') $>, você está <$ if(varObject('global', 'MaleSexNonStatic')==true, 'atrasado', 'atrasada') $>."
			},{
				"tag": "Teacher",
				"character": "Teacher",
				"msn": "Por favor, sente-se para que possamos continuar a aula."
			}]
		},
		"node2": {
			"type": "event",
			"next": "node3",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "Foi um dia chato. As aulas acabaram e a maioria das pessoas te ignorou o dia todo. Há um bilhete de papel na sua mesa dizendo para você ir ao banheiro, há alguém te esperando lá."
			}
		},
		"node3": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05",
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 15
			}
		}
	},
	"table":{
		"root": {
			"type": "dialog",
			"next": "options",
			"fragments": [{
				"tag": "You",
				"msn": "Este lugar está vazio, posso sentar aqui?"
			}]
		},
		"options": {
			"type": "options",
			"questionId": "sitDownClass",
			"options": [{
				"next": "node2",
				"msn": "Sim"
			},
			{
				"msn": "Não"
			}]
		},
		"node2": {
			"type": "dialog",
			"next": "node3",
			"fragments": [{
				"tag": "",
				"msn": "(Você escuta passos se aproximando, o professor chegou)."
			}]
		},
		"node3": {
			"type": "event",
			"next": "changeHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "Foi um dia chato. As aulas acabaram e a maioria das pessoas te ignorou o dia todo. Há um bilhete de papel na sua mesa dizendo para você ir ao banheiro, há alguém te esperando lá."
			}
		},
		"changeHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05",
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 15
			}
		}
	}
}