{
	"bed":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Tenho que ir."
			}]
		}		
	},
	"init":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "node0",
				"condition": "varObject('global', 'NotRepeatedDaysNonStatic') == false"
			}]
		},
		"node0": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Hoje a data do celular está correta."
			},
			{
				"tag": "Você",
				"msn": "O que aconteceu ontem?"
			},
			{
				"tag": "Você",
				"msn": "Foi um sonho? Ou foi anteontem?"
			},
			{
				"tag": "Você",
				"msn": "Estou ficando louco?"
			}]
		}
	},
	"wardrobeInside1":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Não preciso de nada daqui agora."
			}]
		}		
	},
	"wardrobeInside2":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Não estou a fim de organizar isso agora."
			}]
		}		
	},
	"bag":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Vou pegar tudo e sair."
			}]
		},
		"node1": {
			"type": "event",
			"event": {
				"name": "pick",
				"var": "BagPicked",
				"value": true
			}
		},
	},
	"computer":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Se eu ligar agora, com certeza vou me atrasar."
			},
			{
				"tag": "Você",
				"msn": "Melhor esperar até a tarde."
			},
			{
				"tag": "PC",
				"msn": "Você quer ligar o computador?"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "turnOnPC",
			"options": [{
				"next": "node1a",
				"msn": "Sim"
			},
			{
				"next": "node1b",
				"msn": "Não"
			}]
		},
		"node1a": {
			"type": "event",
			"next": "moveCamera",
			"event":{
				"name": "computerON"
			}
		}, 
		"moveCamera": {
			"type": "event",
			"next": "changeHour",
			"event":{
				"name": "move camera",
				"key": "computer"
			}
		},
		"changeHour": {
			"type": "event",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:10",
			}
		},
		"node1b": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Acho melhor eu sair agora."
			}]
		}		
	},
	"plug":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Devo deixar o celular carregando?"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "plugInMobile",
			"options": [{
				"next": "node1a",
				"msn": "Sim"
			},
			{
				"next": "node1b",
				"msn": "Não"
			}]
		},
		"node1a": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": true,
				"state": 0
			}
		}, 
		"node1b": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": false,
				"state": 1
			}
		}		
	},
	"livingroomDoor" : {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "livingroom"
			}
		}
	}
}