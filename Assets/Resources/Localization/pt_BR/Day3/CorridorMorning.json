{
	"alison":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "alisonBoard",
				"condition": "varObject('global', 'AlisonFSNonStatic') > 60"
			},
			{
				"next": "ignore",
				"condition": "true"
			}]
		},	
		"ignore": {
			"type": "dialog",
			"fragments": [{
				"tag": "Alison",
				"character": "Alison",
				"msn": "..."
			},
			{
				"tag": "You",
				"msn": "Novamente me ignorando... O que eu fiz de errado?"
			}]
		}, 
		"alisonBoard": {
			"type": "event",
			"next": "node0",
			"event": {
				"name": "change variable",
				"var": "AlisonBoard",
				"value": true,
			}
		},
		"node0": {
			"type": "fork",
			"options": [{
				"next": "nodeRepeat",
				"condition": "spoken == true"
			},
			{
				"next": "node1",
				"condition": "true"
			}]
		},
		"nodeRepeat": {
			"type": "dialog",
			"fragments": [{
				"tag": "Alison",
				"character": "Alison",
				"msn": "Ignore o mural."
			}]
		}, 
		"node1": {
			"type": "dialog",
			"next": "options",
			"fragments": [{
				"tag": "Alison",
				"character": "Alison",
				"msn": "Eu estava olhando o mural."
			},
			{
				"tag": "Alison",
				"character": "Alison",
				"msn": "E... Será melhor se você ignorá-lo hoje."
			}]
		},
		"options": {
			"type": "options",
			"questionId": "AlisonNoticeBoard",
			"options": [{
				"next": "node1A",
				"msn": "Eu já vi."
			},
			{
				"next": "node1B",
				"msn": "Por quê? O que é?"
			}]
		},
		"node1A": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Alison",
				"character": "Alison",
				"msn": "Desculpe, Alex passou dos limites com isso."
			},
			{
				"tag": "Alison",
				"character": "Alison",
				"msn": "Talvez você devesse falar com o coordenador ou o diretor."
			}]
		},
		"node1B": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Alison",
				"character": "Alison",
				"msn": "Alguém colocou uma foto sua em todos os murais da escola."
			},
			{
				"tag": "Alison",
				"character": "Alison",
				"msn": "Também estava no pátio."
			},
			{
				"tag": "Alison",
				"character": "Alison",
				"msn": "Acho que você deveria procurar qualquer professor disponível para conversar."
			}]
		},
		"setter":{
			"type": "setter",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
	},
	"board":{
		"root": {
			"type": "event",
			"next": "forkNode",
			"event": {
				"name": "change variable",
				"var": "BoardQuest",
				"value": 1,
			}
		},
		"forkNode": {
			"type": "fork",
			"options": [{
				"next": "gum",
				"condition": "varObject('global', 'GumQuestNonStatic') == 0"
			},
			{
				"next": "washed",
				"condition": "varObject('global', 'GumQuestNonStatic') == 1"
			},
			{
				"next": "nogum",
				"condition": "varObject('global', 'GumQuestNonStatic') == 2"
			}]
		},
		"gum": {
			"type": "event",
			"next": "gumDialog",
			"event": {
				"name": "active object",
				"time": 0,
				"other": "photoGum"
			}
		},
		"gumDialog": {
			"type": "dialog",
			"next": "deactive",
			"fragments": [{
				"tag": "You",
				"msn": "É uma foto minha e foi editada para parecer que estou cheio de chicletes no meu traseiro."
			},
			{
				"tag": "You",
				"msn": "Quem será que quer me fazer de idiota desse jeito?"
			}]
		},
		"deactive": {
			"type": "event",
			"event": {
				"name": "deactive object",
				"time": 0
			}
		},
		"washed": {
			"type": "event",
			"next": "washedDialog",
			"event": {
				"name": "active object",
				"time": 0,
				"other": "photoGumWhased"
			}
		},
		"washedDialog": {
			"type": "dialog",
			"next": "deactive",
			"fragments": [{
				"tag": "You",
				"msn": "É uma foto minha de ontem logo após eu limpar o chiclete."
			},
			{
				"tag": "You",
				"msn": "Com uma frase muito original... \"Um bebê chegou na sala\"."
			}]
		},
		"nogum": {
			"type": "event",
			"next": "nogumDialog",
			"event": {
				"name": "active object",
				"time": 0,
				"other": "photoDog"
			}
		},
		"nogumDialog": {
			"type": "dialog",
			"next": "deactive",
			"fragments": [{
				"tag": "You",
				"msn": "É uma foto do meu rosto em um corpo de cachorro com a língua para fora."
			},
			{
				"tag": "You",
				"msn": "Por quê? Quem colocou isso?"
			}]
		},
	},
	"maleBathroom": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "male",
				"condition": "varObject('global', 'MaleSexNonStatic') == true"
			},
			{
				"next": "female",
				"condition": "varObject('global', 'MaleSexNonStatic') == false"
			}]
		},
		"male": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "bathroom"
			}
		},
		"female": {
			"type": "dialog",
			"fragments": [{
				"tag": "You",
				"msn": "Não posso ir lá, é o banheiro dos meninos."
			}]
		}
	},
	"femaleBathroom": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "male",
				"condition": "varObject('global', 'MaleSexNonStatic') == true"
			},
			{
				"next": "female",
				"condition": "varObject('global', 'MaleSexNonStatic') == false"
			}]
		},
		"female": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "bathroom"
			}
		},
		"male": {
			"type": "dialog",
			"fragments": [{
				"tag": "You",
				"msn": "Não posso ir lá, é o banheiro das meninas."
			}]
		}
	},
	"doorToStairs": {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "stairs"
			}
		}
	},
	"classDoor": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "speak",
				"condition": "varObject('global', 'AlisonFSNonStatic') > 60 &&  varObject('state', 'AlisonBoard') == false"
			},
			{
				"next": "move",
				"condition": "true"
			},]
		},
		"move": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "classBack"
			}
		},
		"speak": {
			"type": "dialog",
			"fragments": [{
				"tag": "You",
				"msn": "Eu deveria falar com a Alison antes de entrar, ela tem agido de forma estranha."
			}]
		}
	}
}