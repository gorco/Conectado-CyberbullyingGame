		}		
	},
	"wardrobeInside2":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "..."
			}]
		}		
	},
	"bag":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Vou pegar tudo e sair."
			}]
		},
		"node1": {
			"type": "event",
			"event": {
				"name": "pick",
				"var": "BagPicked",
				"value": true
			}
		}
	},
	"computer":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "PC",
				"msn": "Você quer ligar o computador?"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "turnOnPC",
			"options": [{
				"next": "node1a",
				"msn": "Sim"
			},
			{
				"next": "node1b",
				"msn": "Não"
			}]
		},
		"node1a": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Não está funcionando, está quebrado?"
			}]
		},	
		"node1b": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Melhor não, vou para a aula."
			}]
		}		
	},
	"plug":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Deixo o celular carregando?"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "plugInMobile",
			"options": [{
				"next": "node1a",
				"msn": "Sim"
			},
			{
				"next": "node1b",
				"msn": "Não"
			}]
		},
		"node1a": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": true,
				"state": 0
			}
		}, 
		"node1b": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": false,
				"state": 1
			}
		}		
	},
	"livingroomDoor" : {
		"root": {
			"type": "event",
			"next": "fork",
			"event": {
				"name": "move camera",
				"key": "livingroom"
			}
		},
		"fork": {
			"type": "fork",
			"options": [{
				"next": "parentsGo",
				"condition": "repeated == true"
			}]
		},
		"parentsGo": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Você",
				"msn": "Meus pais já sairam. Vou vê-los de tarde."
			}]
		},	
		"setter":{
			"type": "setter",
			"set": {
				"var": "repeated",
				"value": true
			}
		}
	}
}