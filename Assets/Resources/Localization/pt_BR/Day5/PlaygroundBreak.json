			"type": "dialog",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Você deveria lavar suas roupas, suas calças estão muito sujas."
			},
			{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Você não tem uma máquina de lavar em casa?"
			},
			{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Hahahaha, nova tendência! Chicletes grudados nas calças."
			},
			{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Essas roupas horríveis não valem a pena serem lavadas."
			},
			{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Ele deveria jogar elas direto no lixo."
			},
			{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Hahahaha"
			}]
		}
