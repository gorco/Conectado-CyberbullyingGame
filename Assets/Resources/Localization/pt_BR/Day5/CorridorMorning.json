{
	"alex":{
		"root": {
			"type": "fork",
			"options": [
			{
				"next": "default",
				"condition": "talk == true"
			},
			{
				"next": "sh0",
				"condition": "varObject('global', 'SharedPassQuestNonStatic') == 0"
