				"msn": "Espero que você não perca ele também... ou que ele seja tirado de você."
			}]
		},
		"sh1": {
			"type": "dialog",
			"next": "setter",
			"fragments": [
			{
				"tag": "Álex",
				"character": "Alex",
				"msn": "Olhou suas postagens no \"Conectado\", né?"
			},
			{
				"tag": "Álex",
				"character": "Alex",
				"msn": "Eu não esperava isso de você, até parece que não foi você que escreveu XD."
			}]
		},
		"sh2": {
			"type": "dialog",
			"next": "setter",
			"fragments": [
			{
				"tag": "Álex",
				"character": "Alex",
				"msn": "Olha as mensagens no bate papo. Você surpreendeu todo mundo."
			},
			{
				"tag": "Álex",
				"character": "Alex",
				"msn": "Eu não esperava isso de você. Nem parece que foi você que escreveu hahaha."
			}]
		},
		"setter":{
			"type": "setter",
			"next": "end",
			"set": {
				"var": "talk",
				"value": true
			}
		},
		"end": {
			"type": "dialog",
			"next": "default",
			"fragments": [
			{
				"tag": "Álex",
				"character": "Alex",
				"msn": "Bem, acho que já é o suficiente."
			},
			{
				"tag": "Álex",
				"character": "Alex",
				"msn": "Vamos fazer o seguinte. Quando as aulas acabarem, vamos conversar onde ninguém pode nos ouvir."
			},
			{
				"tag": "Álex",
				"character": "Alex",
				"msn": "Conversamos sobre isso, você pede desculpas e te deixamos em paz."
			},
			{
				"tag": "Álex",
				"character": "Alex",
				"msn": "Ana e eu vamos te deixar em paz e o resto pode fazer o que quiser."
			}]
		},
	},
