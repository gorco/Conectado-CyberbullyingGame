			"fragments": [{
				"tag": "Álex",
				"character": "Alex",
				"msn": "Quando a aula acabar, não esquece de passar lá nos banheiros."
			},
			{
				"tag": "Álex",
				"character": "Alex",
				"msn": "<$ if(varObject('global', 'MaleSexNonStatic')==true, 'Eu estarei lá', 'Ana estará te esperando lá') $>."
			}]
