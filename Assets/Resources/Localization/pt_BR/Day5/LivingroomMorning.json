{
	"mother" : {
		"root": {
			"type": "fork",
			"options": [{
				"next": "nodeA",
				"condition": "varObject('global', 'GumQuestNonStatic') == 0"
			},
			{
				"next": "nodeB",
				"condition": "true"
			}]
		},
		"nodeA": {
			"type": "dialog",
			"fragments": [{
				"tag": "Mãe",
				"character": "Mother",
				"msn": "Se cuide e presta atenção onde você senta."
			},
			{
				"tag": "Mãe",
				"character": "Mother",
				"msn": "Se comporte, até mais tarde."
			}]
		},
		"nodeB": {
			"type": "dialog",
			"fragments": [{
				"tag": "Mãe",
				"character": "Mother",
				"msn": "Se comporte, até mais tarde."
			}]
		}
	},
	"exitDoor": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "changeHour",
				"condition": "varObject('state', 'BagPicked') == true"
			},
			{
				"next": "dialogNode",
				"condition": "varObject('state', 'BagPicked') == false"
			}]
		},
		"changeHour": {
			"type": "event",
			"next": "exitNode",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:20"
			}
		},
		"exitNode": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 24
			}
		},
		"dialogNode": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Esqueci a mochila. Vou voltar ao meu quarto para pegá-la antes de sair."
			}]
		}
	},
	"bedroomDoor" : {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "bedroom"
			}
		}
	}
}