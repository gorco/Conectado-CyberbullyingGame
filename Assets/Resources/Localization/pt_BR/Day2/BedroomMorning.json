{
	"bed":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Vou dormir mais tarde, quando voltar da escola."
			}]
		}		
	},
	"init":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "node0",
				"condition": "varObject('global', 'RepeatedNonStatic') == true"
			}]
		},
		"node0": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Será que sou eu? Ou o telefone estava mostrando a data de ontem?"
			},
			{
				"tag": "Você",
				"msn": "Está quebrado ou algo assim?"
			}]
		}
	},
	"wardrobeInside1":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Não preciso me preocupar com isso agora."
			}]
		}		
	},
	"wardrobeInside2":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Preciso ir para a aula agora e ainda não organizei isso. Vou ter que arrumar depois."
			}]
		}		
	},
	"bag":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Está tudo pronto. Vamos!"
			}]
		},
		"node1": {
			"type": "event",
			"event": {
				"name": "pick",
				"var": "BagPicked",
				"value": true
			}
		},
	},
	"computer":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Devo esperar até a tarde ou vou acabar me atrasando."
			},
			{
				"tag": "PC",
				"msn": "Você quer ligar o computador?"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "plugInMobile",
			"options": [{
				"next": "node1a",
				"msn": "Sim"
			},
			{
				"next": "node1b",
				"msn": "Não"
			}]
		},
		"node1a": {
			"type": "event",
			"next": "moveCamera",
			"event":{
				"name": "computerON"
			}
		}, 
		"moveCamera": {
			"type": "event",
			"next": "changeHour",
			"event":{
				"name": "move camera",
				"key": "computer"
			}
		},
		"changeHour": {
			"type": "event",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:10",
			}
		},
		"node1b": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "É melhor eu ir logo."
			}]
		}		
	},
	"plug":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Deixo meu celular carregando?"
			}]
		},		
		"node1": {
			"type": "options",

			"options": [{
				"next": "node1a",
				"msn": "Sim"
			},
			{
				"next": "node1b",
				"msn": "Não"
			}]
		},
		"node1a": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": true,
				"state": 0
			}
		}, 
		"node1b": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": false,
				"state": 1
			}
		}		
	},
	"livingroomDoor" : {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "livingroom"
			}
		}
	}
}