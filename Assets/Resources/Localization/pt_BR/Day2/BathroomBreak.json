{
	"bathroomExit": {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "corridor"
			}
		}
	},
	"mirror": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "nodeInit",
				"condition": "varObject('global', 'GumQuestNonStatic') != 2"
			}]
		},
		"nodeInit": {
			"type": "fork",
			"options": [{
				"next": "nodeRepeat",
				"condition": "gum == false"
			},
			{
				"next": "node0",
				"condition": "true"
			}]
		},
		"nodeRepeat": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Eu já tirei o chiclete, mas agora ficou uma mancha ainda pior."
			},
			{
				"tag": "Você",
				"msn": "Agora eles vão rir de mim ainda mais."
			}]
		}, 
		"setter":{
			"type": "setter",
			"next": "nodeRepeat",
			"set": {
				"var": "gum",
				"value": false
			}
		},
		"node0": {
			"type": "dialog",
			"next": "options",
			"fragments": [{
				"tag": "Você",
				"msn": "Talvez água e sabão sejam tudo que eu preciso."
			}]
		}, 
		"options": {
			"type": "options",
			"questionId": "bathroomGum",
			"options": [{
				"next": "quest",
				"msn": "(Tentar água e sabão)"
			},
			{
				"msn": "(Melhor deixar como está)"
			}]
		},
		"quest": {
			"type": "event",
			"next": "setter",
			"event": {
				"name": "change variable",
				"var": "GumQuest",
				"value": 1,
			}
		},
	}
}