{
	"maria":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "nodeRepeat",
				"condition": "spoken == true"
			},
			{
				"next": "node0",
				"condition": "true"
			}]
		},
		"nodeRepeat": {
			"type": "dialog",
			"fragments": [{
				"tag": "You",
				"msn": "Já falei com a Alison. Melhor eu procurar por pessoas lá no pátio."
			}]
		}, 
		"setter":{
			"type": "setter",
			"next": "bell",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
		"node0": {
			"type": "fork",
			"options": [{
				"next": "notify1",
				"condition": "varObject('global', 'MariaFSNonStatic') > 60"
			},
			{
				"next": "ignore",
				"condition": "varObject('state', 'MariaFSNonStatic') < 50"
			},
			{
				"next": "normal1",
				"condition": "true"
			}]
		},	
		"notify1": {
			"type": "dialog",
			"next": "notify2",
			"fragments": [{
				"tag": "María",
				"character": "Maria",
				"msn": "Bom dia, <$ varObject('global', 'UserNameNonStatic') $>."
			},
			{
				"tag": "María",
				"character": "Maria",
				"msn": "Ouvi o Alex falando com a Ana sobre fazer uma pegadinha com você."
			},
			{
				"tag": "María",
				"character": "Maria",
				"msn": "Não sei do que se trata, mas cuidado, elas geralmente não são muito engraçadas."
			}]
		}, 
		"notify2": {
			"type": "options",
			"questionId": "MariaJokeAdvise",
			"options": [{
				"next": "notify3",
				"msn": "Obrigado pelo aviso"
			},
			{
				"next": "notify3",
				"msn": "Eu não tenho medo dele"
			},
			{
				"next": "repeatedDay1",
				"msn": "De novo?",
				"condition": "varObject('global', 'RepeatedNonStatic') == true"
			}]
		},
		"repeatedDay1": {
			"type": "dialog",
			"next": "notify3",
			"fragments": [{
				"tag": "María",
				"character": "Maria",
				"msn": "De novo o que?"
			},
			{
				"tag": "You",
				"msn": "(Ela parece não lembrar do aviso de ontem)"
			},
			{
				"tag": "You",
				"msn": "Está bem. Estou indo embora, tchau."
			}]
		},
		"notify3": {
			"type": "event",
			"next": "quest",
			"event":{
				"name": "change variable",
				"var": "JokeAdvise",
				"value": true,
			}
		},
		"quest": {
			"type": "event",
			"next": "notify4",
			"event": {
				"name": "change variable",
				"var": "MariaQuest",
				"value": 1,
			}
		},
		"notify4": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "María",
				"character": "Maria",
				"msn": "Até mais, tchau."
			}]
		}, 
		"ignore": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "María",
				"character": "Maria",
				"msn": "Estou lendo"
			},
			{
				"tag": "María",
				"character": "Maria",
				"msn": "Se não se importa... (Ela te ignora e continua lendo)"
			}]
		}, 
		"normal1": {
			"type": "dialog",
			"next": "normal2",
			"fragments": [{
				"tag": "María",
				"character": "Maria",
				"msn": "Você precisa de alguma coisa?"
			}]
		}, 
		"normal2": {
			"type": "options",
			"questionId": "MariaLonely",
			"options": [{
				"next": "setter",
				"msn": "Não, nada, tchau."
			},
			{
				"next": "normal3b",
				"msn": "Diga olá. Sempre te vejo sozinha e lendo."
			}]
		},
		"normal3b": {
			"type": "event",
			"next": "normal4",
			"event": {
				"name": "change friendship",
				"var": "MariaFS",
				"value": 10,
			}
		},
		"normal4": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "María",
				"character": "Maria",
				"msn": "Muito gentil."
			},
			{
				"tag": "María",
				"character": "Maria",
				"msn": "As pessoas não costumam falar comigo."
			},
			{
				"tag": "María",
				"character": "Maria",
				"msn": "Tenha um bom dia."
			}]
		}, 
		"bell": {
			"type": "dialog",
			"next": "bellEvent",
			"fragments": [
			{
				"tag": "",
				"msn": "<<O sinal está tocando>>"
			}]
		},
		"bellEvent": {
			"type": "event",
			"next": "changeHour",
			"event": {
				"name": "change state",
				"key": "ExitDoorByBell",
				"var": "BellSounded",
				"value": true,
				"state": 0
			}
		},
		"changeHour": {
			"type": "event",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:30",
			}
		}
	},
	"jose":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "nodeRepeat",
				"condition": "spoken == true"
			},
			{
				"next": "node0",
				"condition": "true"
			}]
		},
		"nodeRepeat": {
			"type": "dialog",
			"fragments": [{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Até mais"
			}]
		},
		"node0": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Já viu aquele aplicativo que verifica seu relacionamento com as pessoas com quem você mais conversa?"
			},
			{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Ele diz com quem você se dá bem ou não entre todas as pessoas que o baixaram."
			},
			{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Dizem que é muito preciso, mas não sei explicar direito como ele funciona."
			},
			{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Vi que você já tem."
			}]
		},
		"setter":{
			"type": "setter",
			"next": "quest",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
		"quest": {
			"type": "event",
			"event": {
				"name": "change variable",
				"var": "JoseQuest",
				"value": 1,
			}
		},
	},
	"ana":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "checkGood",
				"condition": "varObject('global', 'AnaFSNonStatic') >= 50"
			},
			{
				"next": "checkBad",
				"condition": "true"
			}]
		},	
		"setter":{
			"type": "setter",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
		"checkBad": {
			"type": "fork",
			"options": [{
				"next": "badSpoken",
				"condition": "spoken == true"
			},
			{
				"next": "bad1",
				"condition": "true"
			}]
		},
		"badSpoken": {
			"type": "dialog",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Sai fora. Não tenho nada para falar com você."
			}]
		},
		"bad1": {
			"type": "dialog",
			"next": "badOptions",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "O que você está olhando? Diz alguma coisa ou sai logo daqui"
			}]
		},
		"badOptions": {
			"type": "options",
			"questionId": "AnaJokeAsk",
			"options": [{
				"msn": "Nada (você sai)."
			},
			{
				"next": "bad2",
				"msn": "Me contaram sobre você e Alex falando de uma brincadeira.",
				"condition": "varObject('state', 'JokeAdvise') == true"
			}]
		},
		"bad2": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "É, e daí? Saia daqui."
			}]
		},
		"checkGood": {
			"type": "fork",
			"options": [{
				"next": "goodSpoken",
				"condition": "spoken == true"
			},
			{
				"next": "good1",
				"condition": "true"
			}]
		},
		"goodSpoken": {
			"type": "dialog",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Sai fora. Não tenho nada para falar com você."
			}]
		},
		"good1": {
			"type": "dialog",
			"next": "goodOptions",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Bom dia, <$ varObject('global', 'UserNameNonStatic') $>."
			},
			{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Você precisa de alguma coisa?"
			}]
		},
		"goodOptions": {
			"type": "options",
			"questionId": "AnaJokeAsk",
			"options": [{
				"msn": "Nada (você sai)"
			},
			{
				"next": "good2",
				"msn": "Me contaram que você e o Alex falando de uma pegadinha.",
				"condition": "varObject('state', 'JokeAdvise') == true"
			}]
		},
		"good2": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Poxa, você nos pegou, foi algo bobo."
			},
			{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Mas não é mais engraçado, não vamos fazer isso."
			}]
		}
	},
	"schoolEnter": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "enterNode",
				"condition": "varObject('state', 'BellSounded') == true" 
			},
			{
				"next": "dialogNode",
				"condition": "varObject('state', 'BellSounded') == false"
			}]
		},
		"enterNode": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "stairs"
			}
		},
		"dialogNode": {
			"type": "dialog",
			"fragments": [{
				"tag": "",
				"msn": "Parece que cheguei cedo e ainda não posso entrar. Melhor eu passar um tempo em outro lugar."
			}]
		}
	},
	"schoolExit": {
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "You",
				"msn": "Acabei de chegar, não posso sair ainda."
			}]
		}
	}
}