{
	"maria":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "nodeRepeat",
				"condition": "spoken == true"
			},
			{
				"next": "node0",
				"condition": "true"
			}]
		},
		"nodeRepeat": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Já falei com a Alice. Melhor eu dar uma olhada no pátio."
			}]
		}, 
		"setter":{
			"type": "setter",
			"next": "bell",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
		"node0": {
			"type": "fork",
			"options": [{
				"next": "notify1",
				"condition": "varObject('global', 'MariaFSNonStatic') > 60"
			},
			{
				"next": "ignore",
				"condition": "varObject('state', 'MariaFSNonStatic') < 50"
			},
			{
				"next": "normal1",
				"condition": "true"
			}]
		},	
		"notify1": {
			"type": "dialog",
			"next": "notify2",
			"fragments": [{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Bom dia, <$ varObject('global', 'UserNameNonStatic') $>."
			},
			{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Ouvi o Alex falando com a Ana sobre fazer uma pegadinha com você."
			},
			{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Não sei do que se trata, mas cuidado, elas geralmente não são muito engraçadas."
			}]
		}, 
		"notify2": {
			"type": "options",
			"questionId": "MariaJokeAdvise",
			"options": [{
				"next": "notify3",
				"msn": "Obrigado pelo aviso"
			},
			{
				"next": "notify3",
				"msn": "Eu não tenho medo dele"
			},
			{
				"next": "repeatedDay1",
				"msn": "De novo?",
				"condition": "varObject('global', 'RepeatedNonStatic') == true"
			}]
		},
		"repeatedDay1": {
			"type": "dialog",
			"next": "notify3",
			"fragments": [{
				"tag": "Maria",
				"character": "Maria",
				"msn": "De novo o que?"
			},
			{
				"tag": "Você",
				"msn": "(Ela parece não lembrar do que aconteceu ontem.)"
			},
			{
				"tag": "Você",
				"msn": "Tudo bem. Estou indo embora, tchau!"
			}]
		},
		"notify3": {
			"type": "event",
			"next": "quest",
			"event":{
				"name": "change variable",
				"var": "JokeAdvise",
				"value": true,
			}
		},
		"quest": {
			"type": "event",
			"next": "notify4",
			"event": {
				"name": "change variable",
				"var": "MariaQuest",
				"value": 1,
			}
		},
		"notify4": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Até mais, tchau!"
			}]
		}, 
		"ignore": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Estou lendo"
			},
			{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Se não se importa... (Ela te ignora e continua lendo.)"
			}]
		}, 
		"normal1": {
			"type": "dialog",
			"next": "normal2",
			"fragments": [{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Você precisa de algo?"
			}]
		}, 
		"normal2": {
			"type": "options",
			"questionId": "MariaLonely",
			"options": [{
				"next": "setter",
				"msn": "Não, nada, tchau."
			},
			{
				"next": "normal3b",
				"msn": "Oi! Sempre te vejo sozinha e lendo."
			}]
		},
		"normal3b": {
			"type": "event",
			"next": "normal4",
			"event": {
				"name": "change friendship",
				"var": "MariaFS",
				"value": 10,
			}
		},
		"normal4": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Que gentil."
			},
			{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Ninguém costuma falar comigo."
			},
			{
				"tag": "Maria",
				"character": "Maria",
				"msn": "Tenha um bom dia."
			}]
		}, 
		"bell": {
			"type": "dialog",
			"next": "bellEvent",
			"fragments": [
			{
				"tag": "",
				"msn": "<<O sinal está tocando>>"
			}]
		},
		"bellEvent": {
			"type": "event",
			"next": "changeHour",
			"event": {
				"name": "change state",
				"key": "ExitDoorByBell",
				"var": "BellSounded",
				"value": true,
				"state": 0
			}
		},
		"changeHour": {
			"type": "event",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:30",
			}
		}
	},
	"jose":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "nodeRepeat",
				"condition": "spoken == true"
			},
			{
				"next": "node0",
				"condition": "true"
			}]
		},
		"nodeRepeat": {
			"type": "dialog",
			"fragments": [{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Até mais"
			}]
		},
		"node0": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Você já viu aquele aplicativo que analisa seu relacionamento com as pessoas com quem mais conversa?"
			},
			{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Ele mostra com quem você se dá bem ou não entre todos que baixaram."
			},
			{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Dizem que é bem preciso, mas não sei explicar exatamente como funciona."
			},
			{
				"tag": "Jose",
				"character": "Jose",
				"msn": "Vi que você já baixou ele."
			}]
		},
		"setter":{
			"type": "setter",
			"next": "quest",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
		"quest": {
			"type": "event",
			"event": {
				"name": "change variable",
				"var": "JoseQuest",
				"value": 1,
			}
		},
	},
	"ana":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "checkGood",
				"condition": "varObject('global', 'AnaFSNonStatic') >= 50"
			},
			{
				"next": "checkBad",
				"condition": "true"
			}]
		},	
		"setter":{
			"type": "setter",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
		"checkBad": {
			"type": "fork",
			"options": [{
				"next": "badSpoken",
				"condition": "spoken == true"
			},
			{
				"next": "bad1",
				"condition": "true"
			}]
		},
		"badSpoken": {
			"type": "dialog",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Sai fora! Não tenho nada pra conversar com você."
			}]
		},
		"bad1": {
			"type": "dialog",
			"next": "badOptions",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "O que você está fazendo? Fala alguma coisa ou sai logo daqui"
			}]
		},
		"badOptions": {
			"type": "options",
			"questionId": "AnaJokeAsk",
			"options": [{
				"msn": "Nada (você sai)."
			},
			{
				"next": "bad2",
				"msn": "Ouvi falar que você e o Alex estavam falando de uma pegadinha.",
				"condition": "varObject('state', 'JokeAdvise') == true"
			}]
		},
		"bad2": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "É daí? Sai daqui."
			}]
		},
		"checkGood": {
			"type": "fork",
			"options": [{
				"next": "goodSpoken",
				"condition": "spoken == true"
			},
			{
				"next": "good1",
				"condition": "true"
			}]
		},
		"goodSpoken": {
			"type": "dialog",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Sai fora! Não tenho nada pra conversar com você."
			}]
		},
		"good1": {
			"type": "dialog",
			"next": "goodOptions",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Bom dia, <$ varObject('global', 'UserNameNonStatic') $>!"
			},
			{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Precisa de alguma coisa?"
			}]
		},
		"goodOptions": {
			"type": "options",
			"questionId": "AnaJokeAsk",
			"options": [{
				"msn": "Nada (você sai)."
			},
			{
				"next": "good2",
				"msn": "Ouvi que você e o Alex estavam falando de uma pegadinha.",
				"condition": "varObject('state', 'JokeAdvise') == true"
			}]
		},
		"good2": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Poxa, você nos pegou! Foi só uma bobeira."
			},
			{
				"tag": "Ana",
				"character": "Ana",
				"msn": "Mas não é mais engraçado, vamos deixar pra lá."
			}]
		}
	},
	"schoolEnter": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "enterNode",
				"condition": "varObject('state', 'BellSounded') == true" 
			},
			{
				"next": "dialogNode",
				"condition": "varObject('state', 'BellSounded') == false"
			}]
		},
		"enterNode": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "stairs"
			}
		},
		"dialogNode": {
			"type": "dialog",
			"fragments": [{
				"tag": "",
				"msn": "Parece que cheguei cedo e ainda não posso entrar. Melhor eu ficar por aqui um tempo."
			}]
		}
	},
	"schoolExit": {
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Acabei de chegar, não posso sair agora."
			}]
		}
	}
}