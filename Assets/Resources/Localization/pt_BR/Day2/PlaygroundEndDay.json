		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Voices",
				"msn": "Hahahahaha"
			}]
		},
	},
	"globalLaugh": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "wash",
				"condition": "varObject('global', 'GumQuestNonStatic') == 1"
			},
			{
				"next": "notGum",
				"condition": "varObject('global', 'GumQuestNonStatic') == 2"
			}
			{
				"next": "notWash",
				"condition": "true"
			}]
		},
		"notGum": {
			"type": "event",
			"event": {
				"name": "fade out",
				"key": "notGum"
			}
		},
		"wash": {
			"type": "dialog",
			"fragments": [{
				"tag": "Voices",
				"msn": "Hahahahaha."
			},
			{
				"tag": "Voices",
				"msn": "Que sujeira, <$ varObject('global', 'UserNameNonStatic') $>, parece que você sujou as calças."
			}]
		},
		"notWash": {
			"type": "dialog",
			"fragments": [{
				"tag": "Voices",
				"msn": "Hahahahaha."
			},
			{
				"tag": "Voices",
				"msn": "Você deveria lavar suas roupas."
			},
			{
				"tag": "Voices",
				"msn": "Não importa o quanto você use aquele chiclete nas calças, ele não vai se tornar moda."
			}]
		}
	},
	"schoolExit": {
		"root": {
			"type": "event",
			"next": "changeHour",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 11
			}
		},
		"changeHour": {
			"type": "event",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "15:00",
			}
		}
