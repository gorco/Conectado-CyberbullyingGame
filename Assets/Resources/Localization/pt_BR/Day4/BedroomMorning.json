{
	"init":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "node0",
				"condition": "varObject('global', 'RepeatedNonStatic') == true"
			}]
		},
		"node0": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "De novo, outro dia repetido... Será que ainda estou sonhando?"
			},
			{
				"tag": "Você",
				"msn": "De quem é essa voz vindo do portal? "
			},
			{
				"tag": "Você",
				"msn": "Por que o dia se repete toda vez que cruzo aquele portal?"
			}]
		}
	},
	"bed":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Outro dia... Preciso ir, espero que passe rápido."
			}]
		}		
	},
	"wardrobeInside1":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Não tem nada útil aqui."
			}]
		}		
	},
	"wardrobeInside2":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Talvez eu devesse organizar isso agora, em vez de ir para a escola... Minha mãe vai ficar brava."
			}]
		}		
	},
	"bag":{
		"root": {
			"type": "dialog",
			"next": "node2",
			"fragments": [{
				"tag": "Você",
				"msn": "Preciso ir... "
			}]
		},
		"node2": {
			"type": "event",
			"event": {
				"name": "pick",
				"var": "BagPicked",
				"value": true
			}
		}
	},
	"computer":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Se eu ligar agora, vou me atrasar."
			},
			{
				"tag": "Você",
				"msn": "É sempre a mesma história, melhor esperar até mais tarde."
			},
			{
				"tag": "PC",
				"msn": "Você quer ligar o computador?"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "turnOnPC",
			"options": [{
				"next": "node1a",
				"msn": "Sim"
			},
			{
				"next": "node1b",
				"msn": "Não"
			}]
		},
		"node1a": {
			"type": "event",
			"next": "moveCamera",
			"event":{
				"name": "computerON"
			}
		}, 
		"moveCamera": {
			"type": "event",
			"next": "changeHour",
			"event":{
				"name": "move camera",
				"key": "computer"
			}
		},
		"changeHour": {
			"type": "event",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:10"
			}
		},
		"node1b": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Acho melhor eu sair agora."
			}]
		}		
	},
	"plug":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "Você",
				"msn": "Devo deixar o celular carregando?"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "plugInMobile",
			"options": [{
				"next": "node1a",
				"msn": "Sim"
			},
			{
				"next": "node1b",
				"msn": "Não"
			}]
		},
		"node1a": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": true,
				"state": 0
			}
		}, 
		"node1b": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": false,
				"state": 1
			}
		}		
	},
	"livingroomDoor" : {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "livingroom"
			}
		}
	}
}