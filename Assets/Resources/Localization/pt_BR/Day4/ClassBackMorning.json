{
	"board":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Parece que alguém pegou a foto de ontem."
			}]
		}
	},
	"class":{
		"root": {
				"type": "fork",
				"options": [{
					"next": "minutes",
					"condition": "varObject('global', 'HourNonStatic') >= 8"
				}]
		},
		"minutes": {
				"type": "fork",
				"options": [{
					"next": "node1",
					"condition": "varObject('global', 'MinuteNonStatic') > 30"
				}]
		},
		"node1": {
			"type": "dialog",
			"next": "node2",
			"fragments": [{
				"tag": "Professor",
				"character": "Teacher",
				"msn": "Você está <$ if(varObject('global', 'MaleSexNonStatic')==true, 'atrasado', 'atrasada') $>."
			},{
				"tag": "Professor",
				"character": "Teacher",
				"msn": "Por favor, sente-se e vamos continuar a aula"
			}]
		},
		"node2": {
			"type": "fork",
			"options": [{
				"next": "endDay",
				"condition": "varObject('global', 'SharedPassQuestNonStatic') == 1"
			},
			{
				"next": "break",
				"condition": "true"
			}]
		},
		"break": {
			"type": "event",
			"next": "breakHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "O sinal está tocando, é hora do recreio..."
			}
		},
		"breakHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "11:05"
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 20
			}
		},
		"endDay": {
			"type": "event",
			"next": "breakHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "As aulas estão durando cada vez mais... Que bom que já é hora de ir para casa."
			}
		},
		"endDayHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05"
			}
		}
	},
	"table":{
		"root": {
			"type": "dialog",
			"next": "options",
			"fragments": [{
				"tag": "Você",
				"msn": "Este lugar está livre. Posso sentar aqui?"
			}]
		},
		"options": {
			"type": "options",
			"questionId": "sitDownClass",
			"options": [{
				"next": "node2",
				"msn": "Sim"
			},
			{
				"msn": "Não"
			}]
		},
		"node2": {
			"type": "dialog",
			"next": "nodeFork",
			"fragments": [{
				"tag": "",
				"msn": "(Você escuta passos, o professor está chegando)"
			}]
		},
		"nodeFork": {
			"type": "fork",
			"options": [{
				"next": "endDay",
				"condition": "varObject('global', 'SharedPassQuestNonStatic') == 1"
			},
			{
				"next": "break",
				"condition": "true"
			}]
		},
		"break": {
			"type": "event",
			"next": "breakHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "O sinal está tocando, é hora do recreio..."
			}
		},
		"breakHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "11:05"
			}
		},
		"endDay": {
			"type": "event",
			"next": "changeHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "As aulas parecem estar durando cada vez mais... Que bom que já é hora de ir para casa."
			}
		},
		"changeHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05"
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 20
			}
		}
	},
}