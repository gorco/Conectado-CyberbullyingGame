{
	"parents": {
		"root": {
			"type": "fork",
			"options": [
			{
				"next": "repeat",
				"condition": "spoken == true"
			},
			{
				"next": "setter",
				"condition": "true"
			}]
		},
		"setter":{
			"type": "setter",
			"next": "checkFS",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
		"repeat": {
			"type": "dialog",
			"fragments": [{
				"tag": "Mãe",
				"character": "Mother",
				"msn": "Se cuida e se comporte bem."
			}, 
			{
				"tag": "Pai",
				"character": "Father",
				"msn": "E não esqueça que vamos visitar a vovó no domingo."
			}]
		},
		"checkFS": {
			"type": "fork",
			"options": [{
				"next": "meeting",
				"condition": "varObject('global', 'ParentsFSNonStatic') >= 80"
			},
			{
				"next": "repeat",
				"condition": "true"
			}]
		},
		"meeting": {
			"type": "dialog",
			"next": "meetingVar",
			"fragments": [{
				"tag": "Mãe",
				"character": "Mother",
				"msn": "Decidimos ir conversar com seu professor para entender o que está acontecendo."
			}, 
			{
				"tag": "Pai",
				"character": "Father",
				"msn": "Vamos pedir uma reunião para amanhã."
			}]
		},		
		"meetingVar": {
			"type": "event",
			"next": "options",
			"event": {
				"name": "change variable",
				"var": "ParentsMeetingQuest",
				"value": 1
			}
		},
		"options": {
			"type": "options",
			"questionId": "parentsMeetingMorninOption",
			"options": [{
				"next": "node1a",
				"msn": "Obrigado."
			},
			{
				"next": "node1b",
				"msn": "Vai piorar tudo..."
			}]
		},
		"node1a": {
			"type": "dialog",
			"next": "changeVariable",
			"fragments": [{
				"tag": "Mãe",
				"character": "Mother",
				"msn": "De jeito nenhum, <$ if(varObject('global', 'MaleSexNonStatic')==true, 'querido', 'querida') $>. Queremos que você fique bem."
			}, 
			{
				"tag": "Pai",
				"character": "Father",
				"msn": "Vamos tentar marcar essa reunião para amanhã, no máximo."
			}]
		},
		"changeVariable": {
			"type": "event",
			"next": "repeat",
			"event": {
				"name": "change variable",
				"var": "ParentsMeetingQuest",
				"value": 2
			}
		},
		"node1b": {
			"type": "dialog",
			"next": "repeat",
			"fragments": [{
				"tag": "Você",
				"msn": "Eu não quero que vocês vão. Vai piorar tudo."
			},
			{
				"tag": "Você",
				"msn": "Eles vão pensar que sou um dedo-duro, e não era tão grave assim."
			}, 
			{
				"tag": "Você",
				"msn": "Deixa pra lá, o tempo vai resolver."
			},
			{
				"tag": "Pai",
				"character": "Father",
				"msn": "Tudo bem, mas nos avise se a situação piorar."
			}]
		}
	},
	"exitDoor": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "changeHourSoon",
				"condition": "varObject('state', 'BagPicked') == true && varObject('global', 'HourNonStatic') < 8"
			},{
				"next": "changeHourLate",
				"condition": "varObject('state', 'BagPicked') == true && varObject('global', 'HourNonStatic') >= 8 "
			},
			{
				"next": "dialogNode",
				"condition": "varObject('state', 'BagPicked') == false"
			}]
		},
		"changeHourLate": {
			"type": "event",
			"next": "exitNode",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:40"
			}
		},
		"changeHourSoon": {
			"type": "event",
			"next": "exitNode",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:20"
			}
		},
		"exitNode": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 19
			}
		},
		"dialogNode": {
			"type": "dialog",
			"fragments": [{
				"tag": "Você",
				"msn": "Esqueci a mochila. É melhor eu ir ao meu quarto pegar antes de sair."
			}]
		}
	},
	"bedroomDoor" : {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "bedroom"
			}
		}
	}
}