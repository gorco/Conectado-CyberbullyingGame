{
	"alison":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "node1",
				"condition": "varObject('state', 'AlisonDialog') == true"
			},
			{
				"next": "node2",
				"condition": "true"
			}]
		},
		"node1": {
			"type": "dialog",
			"fragments": [{
				"tag": "Alice",
				"character": "Alison",
				"msn": "Você conseguiu encontrar a sala de aula."
			},
			{
				"tag": "Alice",
				"character": "Alison",
				"msn": "A menina de cabelo vermelho ao lado da porta é a Maria. Ela também está na nossa turma. Ela é um pouco tímida, mas é legal."
			},
			{
				"tag": "Alice",
				"character": "Alison",
				"msn": "E ao lado do mural está o Guilherme, você já conheceu ele."
			}]
		},
		"node2": {
			"type": "dialog",
			"fragments": [{
				"tag": "Alice",
				"character": "Alison",
				"msn": "Desculpe, estou com pressa e vou me atrasar se não entrar agora."
			}]
		}			
	},
	"maria":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "Maria",
				"character": "Maria",
				"msn": "..."
			},
			{
				"tag": "Você",
				"msn": "Ela parece desconfortável. É melhor deixá-la sozinha por enquanto."
			}]
		}		
	},
	"guillermo":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "node1",
				"condition": "spoken == true"
			},
			{
				"next": "node2",
				"condition": "true"
			}]
		},
		"node1": {
			"type": "dialog",
			"fragments": [{
				"tag": "Guilherme",
				"character": "Guille",
				"msn": "Não se esqueça de olhar o mural. Às vezes, tem coisas interessantes lá."
			}]
		},		
		"node2": {
			"type": "dialog",
			"next": "quest",
			"fragments": [{
				"tag": "Guilherme",
				"character": "Guille",
				"msn": "Oi, eu estava lendo o mural agora."
			},
			{
				"tag": "Guilherme",
				"character": "Guille",
				"msn": "Tem algumas mensagens e adesivos bem legais por lá."
			},
			{
				"tag": "Guilherme",
				"character": "Guille",
				"msn": "É bom dar uma olhada pelo menos uma vez por dia, é importante se acostumar a fazer isso."
			},
			{
				"tag": "Guilherme",
				"character": "Guille",
				"msn": "Vamos entrar?"
			}]
		},	
		"quest": {
			"type": "event",
			"next": "setter",
			"event": {
				"name": "change variable",
				"var": "GuillermoQuest",
				"value": 2,
			}
		},
		"setter":{
			"type": "setter",
			"set": {
				"var": "spoken",
				"value": true
			}
		}
	},
