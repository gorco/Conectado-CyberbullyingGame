				"key": "livingroom"
			}
		},
		"fork": {
			"type": "fork",
			"options": [{
				"next": "parentsGo",
				"condition": "repeated == true"
			}]
		},
		"parentsGo": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
