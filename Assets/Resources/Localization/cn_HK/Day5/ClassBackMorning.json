{
	"class":{
		"root": {
				"type": "fork",
				"options": [{
					"next": "minutes",
					"condition": "varObject('global', 'HourNonStatic') >= 8"
				}]
		},
		"minutes": {
				"type": "fork",
				"options": [{
					"next": "node1",
					"condition": "varObject('global', 'MinuteNonStatic') > 30"
				}]
		},
		"node1": {
			"type": "dialog",
			"next": "node2",
			"fragments": [{
				"tag": "老師",
				"character": "Teacher",
				"msn": "<$ varObject('global', 'UserNameNonStatic') $> 你遲到。"
			},{
				"tag": "老師",
				"character": "Teacher",
				"msn": "請坐，我地繼續上堂。"
			}]
		},
		"node2": {
			"type": "event",
			"next": "node3",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "課堂已經完啦，但是成日都有人注視你、係你背後竊竊私語。"
			}
		},
		"node3": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05",
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 25
			}
		}
	},
	"table":{
		"root": {
			"type": "dialog",
			"next": "options",
			"fragments": [{
				"tag": "你",
				"msn": "呢個位空咗，我可唔可以坐係呢度?"
			}]
		},
		"options": {
			"type": "options",
			"questionId": "sitDownClass",
			"options": [{
				"next": "node2",
				"msn": "好"
			},
			{
				"msn": "唔好"
			}]
		},
		"node2": {
			"type": "dialog",
			"next": "node3",
			"fragments": [{
				"tag": "",
				"msn": "(後面有人敲門，老師已到)"
			}]
		},
		"node3": {
			"type": "event",
			"next": "changeHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "又係在你背後竊竊私語的一天。該回家啦。"
			}
		},
		"changeHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "14:05",
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 25
			}
		}
	}
}