{
	"bed":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "你",
				"msn": "嗯，媽咪，係咪依家要去瞓覺？"
			}]
		},
		"node1": {
			"type": "options",
			"questionId": "goToSleep",
			"options": [{
				"next": "sleepfork",
				"msn": "係"
			},
			{
				"msn": "唔係"
			}]
		},
		"sleepfork": {
			"type": "fork",
			"options": [{
				"next": "sleep",
				"condition": "varObject('global', 'SharedPassQuestNonStatic') == 0"
			},{
				"next": "scene",
				"condition": "true"
			}]
		},
		"sleep": {
			"type": "dialog",
			"next": "scene",
			"fragments": [{
				"tag": "你 ",
				"msn": "但係我而家用唔到電話嘅鬧鐘。"
			},
			{
				"tag": "你",
				"msn": "嗯，我會用返部舊電話，但係冇SIM卡，淨係可以當鬧鐘"
			},
			{
				"tag": "你",
				"msn": "好啦，校咗鬧鐘，準備瞓覺。"
			}]
		},
		"scene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 22,
				"time": 3
			}
		}		
	},
