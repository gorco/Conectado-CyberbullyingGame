{
	"bed":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "我得走了。"
			}]
		}		
	},
	"init":{
		"root": {
			"type": "fork",
			"options": [{
				"next": "node0",
				"condition": "varObject('global', 'NotRepeatedDaysNonStatic') == false"
			}]
		},
		"node0": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "今天電話上顯示了正確的的日期。"
			},
			{
				"tag": "你",
				"msn": "昨天發生了什麽？"
			},
			{
				"tag": "你",
				"msn": "那是夢嗎？那是前天嗎？"
			},
			{
				"tag": "你",
				"msn": "我正在變得瘋狂嗎？"
			}]
		}
	},
	"wardrobeInside1":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "我現在不需要這裏的任何東西。"
			}]
		}		
	},
	"wardrobeInside2":{
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "我現在沒有心情組織。"
			}]
		}		
	},
	"bag":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "你",
				"msn": "我會攞好所有東西並離開。"
			}]
		},
		"node1": {
			"type": "event",
			"event": {
				"name": "pick",
				"var": "BagPicked",
				"value": true
			}
		},
	},
	"computer":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "你",
				"msn": "如果我現在開它，我絕對會遲到。"
			},
			{
				"tag": "你",
				"msn": "最好等到下午。"
			},
			{
				"tag": "個人電腦",
				"msn": "你係咪想開電腦？"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "turnOnPC",
			"options": [{
				"next": "node1a",
				"msn": "係"
			},
			{
				"next": "node1b",
				"msn": "唔係"
			}]
		},
		"node1a": {
			"type": "event",
			"next": "moveCamera",
			"event":{
				"name": "computerON"
			}
		}, 
		"moveCamera": {
			"type": "event",
			"next": "changeHour",
			"event":{
				"name": "move camera",
				"key": "computer"
			}
		},
		"changeHour": {
			"type": "event",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "8:10",
			}
		},
		"node1b": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "我最好現在離開。"
			}]
		}		
	},
	"plug":{
		"root": {
			"type": "dialog",
			"next": "node1",
			"fragments": [{
				"tag": "你",
				"msn": "我好唔好留低手提電話叉電?"
			}]
		},		
		"node1": {
			"type": "options",
			"questionId": "plugInMobile",
			"options": [{
				"next": "node1a",
				"msn": "係"
			},
			{
				"next": "node1b",
				"msn": "唔係"
			}]
		},
		"node1a": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": true,
				"state": 0
			}
		}, 
		"node1b": {
			"type": "event",
			"event": {
				"name": "change state",
				"var": "ChargingMobile",
				"value": false,
				"state": 1
			}
		}		
	},
	"livingroomDoor" : {
		"root": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "livingroom"
			}
		}
	}
}