				"next": "checkGood",
				"condition": "varObject('global', 'AnaFSNonStatic') >= 50"
			},
			{
				"next": "checkBad",
				"condition": "true"
			}]
		},	
		"setter":{
			"type": "setter",
			"set": {
				"var": "spoken",
				"value": true
			}
		},
		"checkBad": {
			"type": "fork",
			"options": [{
				"next": "badSpoken",
				"condition": "spoken == true"
			},
			{
				"next": "bad1",
				"condition": "true"
			}]
		},
		"badSpoken": {
			"type": "dialog",
