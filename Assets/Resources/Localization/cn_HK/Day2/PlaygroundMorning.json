			},
			{
				"tag": "安娜",
				"character": "Ana",
				"msn": "但這已經不好玩了，我們不會做的。"
			}]
		}
	},
	"schoolEnter": {
		"root": {
			"type": "fork",
			"options": [{
				"next": "enterNode",
				"condition": "varObject('state', 'BellSounded') == true" 
			},
			{
				"next": "dialogNode",
				"condition": "varObject('state', 'BellSounded') == false"
			}]
		},
		"enterNode": {
			"type": "event",
			"event": {
				"name": "move camera",
				"key": "stairs"
			}
		},
		"dialogNode": {
			"type": "dialog",
			"fragments": [{
				"tag": "",
				"msn": "看來我早到了，現在還不能進去。我最好消磨一下時間。"
			}]
		}
	},
	"schoolExit": {
		"root": {
			"type": "dialog",
			"fragments": [{
				"tag": "你",
				"msn": "我剛剛到，還不能離開。"
			}]
		}
	}
}