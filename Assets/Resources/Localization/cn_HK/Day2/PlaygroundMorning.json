				"condition": "varObject('state', 'JokeAdvise') == true"
			}]
		},
		"bad2": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "安娜",
				"character": "Ana",
				"msn": "是啊，那又怎樣？走開吧"
			}]
		},
		"checkGood": {
			"type": "fork",
			"options": [{
				"next": "goodSpoken",
				"condition": "spoken == true"
			},
			{
				"next": "good1",
				"condition": "true"
			}]
		},
		"goodSpoken": {
			"type": "dialog",
			"fragments": [{
				"tag": "安娜",
				"character": "Ana",
				"msn": "走開。我沒什麼好跟你說的。"
			}]
		},
		"good1": {
			"type": "dialog",
			"next": "goodOptions",
			"fragments": [{
				"tag": "安娜",
				"character": "Ana",
				"msn": "早上好，<$ varObject('global', 'UserNameNonStatic') $>。"
			},
			{
				"tag": "安娜",
				"character": "Ana",
				"msn": "你有什麼事嗎？"
			}]
		},
		"goodOptions": {
			"type": "options",
			"questionId": "AnaJokeAsk",
			"options": [{
				"msn": "沒有（你離開）。"
			},
			{
				"next": "good2",
				"msn": "我聽講你和阿歷正在談論一些惡作劇。",
				"condition": "varObject('state', 'JokeAdvise') == true"
			}]
		},
		"good2": {
			"type": "dialog",
			"next": "setter",
			"fragments": [{
				"tag": "安娜",
				"character": "Ana",
