{
	"class":{
		"root": {
				"type": "fork",
				"options": [{
					"next": "minutes",
					"condition": "varObject('global', 'HourNonStatic') >= 8"
				}]
		},
		"minutes": {
				"type": "fork",
				"options": [{
					"next": "node1",
					"condition": "varObject('global', 'MinuteNonStatic') > 30"
				}]
		},
		"node1": {
			"type": "dialog",
			"next": "node2",
			"fragments": [{
				"tag": "老師",
				"character": "Teacher",
				"msn": "<$ varObject('global', 'UserNameNonStatic') $> 你遲到了。"
			},{
				"tag": "老師",
				"character": "Teacher",
				"msn": "請坐，我們繼續上課。"
			}]
		},
		"node2": {
			"type": "event",
			"next": "node3",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "你走到你睇到的第一張空枱前坐低，所有人都望住你。"
			}
		},
		"node3": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 10
			}
		}
	},
	"table":{
		"root": {
			"type": "dialog",
			"next": "options",
			"fragments": [{
				"tag": "你",
				"msn": "這個地方是空的，我可以坐這裡嗎？"
			}]
		},
		"options": {
			"type": "options",
			"questionId": "sitDownClass",
			"options": [{
				"next": "node2",
				"msn": "是"
			},
			{
				"msn": "不是"
			},
			{
				"next": "gum",
				"msn": "看看椅子",
				"condition": "varObject('global', 'RepeatedNonStatic') == true"
			}]
		},
		"node2": {
			"type": "dialog",
			"next": "node3",
			"fragments": [{
				"tag": "",
				"msn": "(背後敲門，老師來了)"
			}]
		},
		"gum": {
			"type": "dialog",
			"next": "noGum",
			"fragments": [{
				"tag": "你",
				"msn": "上面黏著一塊香口膠。"
			},
			{
				"tag": "你",
				"msn": "可能昨天也發生了同樣的事，我最好把它清理然後坐下。"
			}]
		},
		"noGum": {
			"type": "event",
			"next": "node3",
			"event": {
				"name": "change variable",
				"var": "GumQuest",
				"value": 2,
			}
		},
		"node3": {
			"type": "event",
			"next": "changeHour",
			"event": {
				"name": "black",
				"synchronous": true,
				"var": "text",
				"value": "你地都坐低後先意識到已經係休息時間啦。"
			}
		},
		"changeHour": {
			"type": "event",
			"next": "nextScene",
			"event":{
				"name": "change variable",
				"var": "hour",
				"value": "11:05",
			}
		},
		"nextScene": {
			"type": "event",
			"event": {
				"name": "change scene",
				"var": "scene",
				"value": 10
			}
		}
	}
}